# Secrets — never commit
api/config.php

# Filesystem cache + rate-limit state
api/_cache/*
!api/_cache/.htaccess
!api/_cache/.gitkeep

# Application logs (folder tracked, contents ignored)
api/logs/*
!api/logs/.htaccess
!api/logs/.gitkeep

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Logs
*.log

# Dependencies (generated; not committed)
node_modules/
package-lock.json

# dist/ is a PREBUILT, COMMITTED deploy artifact — shared hosts can't run
# `node build.js`, so the whole built tree ships in the repo and must stay
# complete. Track everything under dist/ EXCEPT its runtime-generated junk
# and secrets (mirrors the api/ rules above).
dist/api/config.php
dist/api/_cache/*
!dist/api/_cache/.htaccess
!dist/api/_cache/.gitkeep
dist/api/storage/*
!dist/api/storage/.htaccess
!dist/api/storage/.gitkeep
dist/api/logs/*
!dist/api/logs/.htaccess
!dist/api/logs/.gitkeep

# Local database + storage (SQLite dev DB, generated)
api/storage/*
!api/storage/.htaccess
!api/storage/.gitkeep
