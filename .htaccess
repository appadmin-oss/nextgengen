# ===============================================================
# Next Generation Genius — shared hosting config (Apache)
# ===============================================================

# Default index
DirectoryIndex index.html

# Disable directory listing
Options -Indexes

# UTF-8 default
AddDefaultCharset UTF-8

# ---------------------------------------------------------------
# MIME types (for hosts that don't ship them by default)
# ---------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/svg+xml             .svg
  AddType image/webp                .webp
  AddType image/avif                .avif
  AddType application/javascript    .js .mjs
  AddType text/jsx                  .jsx
  AddType font/woff                 .woff
  AddType font/woff2                .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# ---------------------------------------------------------------
# Gzip / Deflate compression
# ---------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# ---------------------------------------------------------------
# Long-lived static caching
# ---------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 hour"

  # HTML — short cache so updates ship fast
  ExpiresByType text/html                     "access plus 5 minutes"

  # JS / CSS / JSX
  ExpiresByType text/css                      "access plus 7 days"
  ExpiresByType application/javascript        "access plus 7 days"
  ExpiresByType text/jsx                      "access plus 7 days"

  # Images & fonts — long cache
  ExpiresByType image/png                     "access plus 30 days"
  ExpiresByType image/jpeg                    "access plus 30 days"
  ExpiresByType image/webp                    "access plus 30 days"
  ExpiresByType image/avif                    "access plus 30 days"
  ExpiresByType image/svg+xml                 "access plus 30 days"
  ExpiresByType image/x-icon                  "access plus 30 days"
  ExpiresByType font/woff                     "access plus 90 days"
  ExpiresByType font/woff2                    "access plus 90 days"

  # Manifest
  ExpiresByType application/manifest+json     "access plus 1 day"
</IfModule>

# ---------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"

  # JSX files: we still want them treated as scripts (text/babel)
  <FilesMatch "\.jsx$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------
# Block hidden files & sources
# ---------------------------------------------------------------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "\.(md|log|sh|zip|gz|sql|bak|swp)$">
  Require all denied
</FilesMatch>

# ---------------------------------------------------------------
# SPA-friendly fallback — keeps deep links pointing to index.html.
# The app handles routing client-side via React state.
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Don't rewrite real files / directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Don't rewrite known asset paths
  RewriteRule ^(assets|uploads)/ - [L]

  # Everything else → index.html
  RewriteRule ^ index.html [L]
</IfModule>

# ErrorDocument fallbacks point back at the SPA
ErrorDocument 404 /index.html
