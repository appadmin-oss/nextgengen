# Block direct access to library files and cache.
RewriteEngine On
RewriteRule ^_lib/        - [F,L]
RewriteRule ^_cache/      - [F,L]
RewriteRule ^config\.php$ - [F,L]

# Disable directory listings.
Options -Indexes

# CORS (same-origin by default; loosen here if the API is on a separate
# subdomain from the frontend).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>

# Force HTTPS (uncomment after SSL is verified).
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Prevent caching of API responses by default — endpoints opt in with
# their own headers if they want it.
<IfModule mod_headers.c>
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  Header always set Pragma "no-cache"
</IfModule>
