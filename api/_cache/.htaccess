# Nothing in here is web-servable.
#
# Both syntaxes, because the wrong one is not a smaller mistake. `Require` is
# Apache 2.4 (mod_authz_core) and hard-fails a 2.2 host with a 500 on every
# request under this path; `Order`/`Deny` is 2.2 and is IGNORED by 2.4 unless
# mod_access_compat happens to be loaded. A shared host can be either, and a
# deny that is silently ignored is the same as no deny at all.
#
# (api/storage/.htaccess has guarded both since the local photo store landed and
# writes out the same reasoning. This directory did not, and held the response
# cache and the rate-limit counters in the open on any Apache 2.4 without
# mod_access_compat.)
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
Options -Indexes
