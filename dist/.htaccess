# ===============================================================
# Next Generation Genius — shared hosting config (Apache)
# ===============================================================

# Default index
DirectoryIndex index.html

# Disable directory listing
Options -Indexes

# UTF-8 default
AddDefaultCharset UTF-8

# ---------------------------------------------------------------
# MIME types (for hosts that don't ship them by default)
# ---------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/svg+xml             .svg
  AddType image/webp                .webp
  AddType image/avif                .avif
  AddType application/javascript    .js .mjs
  AddType text/jsx                  .jsx
  AddType font/woff                 .woff
  AddType font/woff2                .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# ---------------------------------------------------------------
# Gzip / Deflate compression
# ---------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# ---------------------------------------------------------------
# Long-lived static caching
# ---------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 hour"

  # JSON is the API's content type, and ExpiresDefault above would otherwise
  # give every reply a one-hour freshness window — the browser then answers
  # reads from its own cache and an admin's save appears not to have happened.
  # PHP sends no-store on every response too; this is here for any JSON that
  # never reaches PHP, and so the rule is visible next to the one it corrects.
  ExpiresByType application/json              "access plus 0 seconds"

  # HTML — short cache so updates ship fast
  ExpiresByType text/html                     "access plus 5 minutes"

  # JS / CSS / JSX
  ExpiresByType text/css                      "access plus 7 days"
  ExpiresByType application/javascript        "access plus 7 days"
  ExpiresByType text/jsx                      "access plus 7 days"

  # Images & fonts — long cache
  ExpiresByType image/png                     "access plus 30 days"
  ExpiresByType image/jpeg                    "access plus 30 days"
  ExpiresByType image/webp                    "access plus 30 days"
  ExpiresByType image/avif                    "access plus 30 days"
  ExpiresByType image/svg+xml                 "access plus 30 days"
  ExpiresByType image/x-icon                  "access plus 30 days"
  ExpiresByType font/woff                     "access plus 90 days"
  ExpiresByType font/woff2                    "access plus 90 days"

  # Manifest
  ExpiresByType application/manifest+json     "access plus 1 day"
</IfModule>

# ---------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # microphone=(self), not (): the member portal's voice notes and the English Lab's "Hear and say" step
  # record from this site's own pages. A denied capability fails silently in the browser (6 Nov 2026).
  Header always set Permissions-Policy "geolocation=(), camera=(self), microphone=(self), payment=(), interest-cohort=()"
  Header always set X-DNS-Prefetch-Control "on"

  # Strict-Transport-Security — uncomment AFTER HTTPS is verified and you're
  # sure you'll keep using it. Hard to roll back from preload.
  # Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

  # Content-Security-Policy.
  #
  # NO FONT HOST. Google Fonts is gone from style-src, font-src and
  # connect-src because nothing fetches it any more — every face the app,
  # the ID cards and the posters draw in is in /assets/fonts. That is not
  # only speed: a mobile operator zero-rating this service whitelists
  # HOSTNAMES, and a learner on free data whose fonts come from a host the
  # operator did not whitelist either pays for them or waits for a timeout.
  # The policy is the inventory; see docs/ZERO-RATING.md.
  #
  # frame-src is REQUIRED, not optional. There is no default for it: without the
  # directive it inherits default-src 'self', which silently blocks every
  # cross-origin iframe — the in-page PDF viewer (documents are served from
  # Cloudinary) and YouTube embeds both render as an empty box with a console
  # error and nothing else. Only the hosts we actually frame are listed — and
  # Vimeo's player, because a lesson may embed a Vimeo video. media-src lets a
  # lesson play an audio or video material in place (our own store, or https).
  #
  # youtube-nocookie.com rather than youtube.com for the embed itself: it is the
  # same player without the tracking cookie being set before a member presses
  # play. youtube.com stays listed because the player redirects to it for some
  # content, and a blocked redirect looks like a broken video.
  #
  # worker-src: pica (the image resampler behind upload shrinking and the photo
  # studio) starts its worker pool from a blob URL. Without this it inherits
  # default-src 'self', the workers are refused, and every resize falls back to
  # the main thread — correct output, but it janks the tab on a large photo.
  # blob: workers are same-origin-derived, so this is not a real loosening.
  #
  # connect-src lists res.cloudinary.com and the two Google Fonts hosts because
  # the ID card printer reads them with fetch(), not an <img>: snapDOM inlines
  # every photo and font into the card it rasterises, and the card photo asks
  # Cloudinary where the face is (fl_getinfo). Without them a printed card came
  # out with a blank photo box and a fallback font, and nothing said so. data:
  # is an uploaded card image being inlined the same way.
  #
  # The file-storage bucket (api/_lib/object-store.php) is listed the same way:
  # *.r2.cloudflarestorage.com and *.backblazeb2.com take the browser's direct
  # PUT of an upload; *.r2.dev and *.backblazeb2.com serve the files back to
  # fetch() and to the document viewer's frame. Amazon S3, Wasabi, DigitalOcean
  # Spaces and Supabase (STORAGE_PROVIDERS, service-keys.php) both take the PUT
  # and serve on their own domains. IDrive e2's hosts carry a per-region number
  # (idrivee2-46.com) no wildcard can cover, so — like a bucket on a CUSTOM domain
  # (files.example.org) must be added to connect-src and frame-src here by
  # hand, or uploads and printed photos fail with a CSP error in the console.
  Header always set Content-Security-Policy "default-src 'self'; \
script-src 'self' 'sha256-YjP3q340SssGzfDxgdsVZsI24XcgHIdAU3UDhygHUp0=' 'sha256-ASeAsjmszLOr0kt3B2Fj+iQMh8bualLheARFcxKRI9I=' 'sha256-KqYiZgb12lPzIwIozw+2Qjih8YIghcef44sUWpw8kjA=' 'sha256-wTtV1fZ1LDkHeQLSubl2Dm/5+Ut1tJdcipzYHpbUkCc=' 'sha256-mKIF9SO7F9PdewecOKNZgV6Rxs27qr2vGcMQWtIUTDI=' 'sha256-1kg2x4XteKTODYzGnkjEe1nQJYOSvlvJY4fdtuKo6OQ=' 'sha256-xHa/pnm6+KO5RpKF+7KJ2uoALZHW93H0tKhWCmyOsas=' 'sha256-0oum4Q4hYuyjH6H7YRlAYOwOsMf5vXmTkbTw7FVaheI=' 'unsafe-hashes' 'sha256-MguIPR6qNR8D3B+eAlK+bIRTZe8t3wkOY4B/56Me9FU=' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc='; \
style-src 'self' 'unsafe-inline'; \
img-src 'self' data: https: blob:; \
font-src 'self' data:; \
connect-src 'self' https://api.cloudinary.com https://res.cloudinary.com https://*.r2.cloudflarestorage.com https://*.r2.dev https://*.backblazeb2.com https://*.amazonaws.com https://*.wasabisys.com https://*.digitaloceanspaces.com https://*.supabase.co https://api.dictionaryapi.dev data: blob:; \
worker-src 'self' blob:; \
frame-src 'self' https://res.cloudinary.com https://*.r2.dev https://*.backblazeb2.com https://*.amazonaws.com https://*.wasabisys.com https://*.digitaloceanspaces.com https://*.supabase.co https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com; \
media-src 'self' https: blob:; \
frame-ancestors 'self'; \
base-uri 'self'; \
form-action 'self'; \
object-src 'none'"

  # The Study tools' code playground runs a member's own HTML/CSS/JS in this
  # one page, under its own policy: inline scripts allowed (they are the
  # member's code), NO network (default-src 'none'), and a sandbox without
  # allow-same-origin, so it is an opaque origin that cannot read this site's
  # cookies, storage or pages. Only this site may frame it.
  <Files "code-sandbox.html">
    Header always set Content-Security-Policy "default-src 'none'; script-src 'unsafe-inline' 'unsafe-eval'; style-src 'unsafe-inline'; img-src data: blob:; font-src data:; media-src data: blob:; frame-ancestors 'self'; sandbox allow-scripts allow-modals"
    Header always unset X-Frame-Options
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>

  # JSX files: treated as scripts (text/babel) in the dev/root deploy. They
  # keep the SAME name across deploys, so they must revalidate every load or a
  # source edit wouldn't show for days. Cheap 304s when unchanged.
  <FilesMatch "\.jsx$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
  </FilesMatch>
  # Vendored / hashless libraries and any other JS/CSS — safe to cache a while
  # (they change rarely), but still revalidate once stale.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=604800, must-revalidate"
  </FilesMatch>
  # Long-lived assets — immutable cache.
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
  # Entry files that keep a FIXED name across every deploy (the app bundle,
  # client, content, styles, shell HTML, manifest). A long fresh window here is
  # exactly what makes "my changes aren't showing" happen — a returning or
  # SW-less browser keeps serving the old copy. Force revalidation so a deploy
  # is always picked up; the service worker still gives instant repeat loads.
  # MUST come after the generic .js/.css rules so it wins for these names.
  # (Basenames also match the Journal PWA's copies under /journal/ — app.min.js,
  # app.css, index.html, manifest.webmanifest.)
  <FilesMatch "^(index\.html|app\.min\.js|app-more\.min\.js|app\.css|api-client\.js|outbox\.js|data\.js|photos\.js|styles\.css|styles-app\.css|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
  </FilesMatch>
  # FINGERPRINTED entry files — app.4f2a1b9c33.min.js, styles.<tag>.css. The
  # name contains a hash of the file's own contents, so these bytes are the only
  # bytes that URL will ever have: cache for a year and never revalidate. This
  # is the pair to the rule above, and it has to come AFTER it so the hashed
  # names are not caught by the fixed-name pattern (app.<tag>.min.js does not
  # match ^app\.min\.js$, but the generic .js rule above it would apply the
  # weaker must-revalidate).
  #
  # `immutable` is the part that matters: without it a browser still sends a
  # conditional request on a hard reload and pays a round trip to be told
  # nothing changed. A deploy is picked up because index.html — served no-cache
  # — points at different names, not because anything expired.
  <FilesMatch "\.[0-9a-f]{10}\.(min\.)?(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header unset Expires
  </FilesMatch>
  # The precompressed copies: the type of what they hold, the encoding they are in, never compressed a second
  # time, and the same year-long immutable life as the file they copy.
  <FilesMatch "\.(br|gz)$">
    RemoveType .br .gz
    RemoveEncoding .br .gz
    Header append Vary Accept-Encoding
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header unset Expires
  </FilesMatch>
  <FilesMatch "\.js\.(br|gz)$">
    ForceType "application/javascript; charset=utf-8"
  </FilesMatch>
  <FilesMatch "\.css\.(br|gz)$">
    ForceType "text/css; charset=utf-8"
  </FilesMatch>
  <FilesMatch "\.br$">
    Header set Content-Encoding br
  </FilesMatch>
  <FilesMatch "\.gz$">
    Header set Content-Encoding gzip
  </FilesMatch>
  # The API. Live data, sessions and children's records — never cacheable by
  # the browser or by anything between us and it. Mirrors the no-store header
  # PHP sends, so the answer is the same even if a rewrite serves a JSON file
  # directly or a proxy strips the application layer's headers.
  #
  # SetEnvIf rather than <If>: <If> is Apache 2.4 only and hard-fails a 2.2
  # host with a 500 on every request. mod_setenvif works on both.
  SetEnvIf Request_URI "^/api/" NGG_NOSTORE=1
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=NGG_NOSTORE
  Header always set Pragma "no-cache" env=NGG_NOSTORE
  Header always unset Expires env=NGG_NOSTORE
  # Service workers: MUST come last. Never cache the SW scripts themselves — a
  # new deploy is then always picked up on the next visit, and the SW refreshes
  # the running app (main app: service-worker.js; Journal PWA: journal/sw.js).
  <FilesMatch "^(service-worker|sw)\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header unset Expires
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------
# Block hidden files & sources.
#
# Doubled syntax throughout: `Require` is Apache 2.4 and 500s a 2.2 host;
# `Order`/`Deny` is 2.2 and is ignored by 2.4 without mod_access_compat. A
# shared host can be either, and these blocks are what keep .git, the schema
# mirror, backups and a stray config.php off the web — a deny that is silently
# ignored is the same as no deny at all.
# ---------------------------------------------------------------
<FilesMatch "^\.">
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
</FilesMatch>
<FilesMatch "\.(md|log|sh|zip|gz|sql|bak|swp|inc|tpl|env)$">
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
</FilesMatch>
# Block any accidental upload of config.php at the document root.
<FilesMatch "^config\.php$">
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
</FilesMatch>

# ---------------------------------------------------------------
# SPA-friendly fallback — keeps deep links pointing to index.html.
# The app handles routing client-side via React state.
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # No PHP runs at the document root. Every endpoint lives under api/, and a
  # .php file beside index.html is a dev helper or a stray upload — _mint.php
  # was one, and it printed a signed super-admin session to anyone who asked.
  # Checked BEFORE the real-file pass below, which would otherwise serve it.
  # Relative to this directory, so it holds when the site is in a subfolder.
  RewriteRule ^[^/]+\.php$ - [F,L]

  # PRECOMPRESSED copies (build.js writes app.<hash>.min.js.br and .gz beside each fingerprinted script and
  # stylesheet). Brotli at its highest setting is ~20% smaller than the gzip mod_deflate makes on the fly, and
  # costs the host no CPU per request. Only fingerprinted names have copies, so a copy can never be stale.
  # Before the real-file pass: the copy is a real file too, and this decides which one is sent.
  RewriteCond %{HTTP:Accept-Encoding} \bbr\b
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule ^(.+\.(?:js|css))$ $1.br [E=no-gzip:1,L]
  RewriteCond %{HTTP:Accept-Encoding} \bgzip\b
  RewriteCond %{REQUEST_FILENAME}.gz -f
  RewriteRule ^(.+\.(?:js|css))$ $1.gz [E=no-gzip:1,L]

  # Don't rewrite real files / directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Legacy route: the public attendance board moved to /s-status. Permanent
  # redirect so old bookmarks/shared links never 404 (the SPA also aliases it).
  RewriteRule ^status/?$ /s-status [R=301,L]

  # Don't rewrite known asset paths or the API tree (its own .htaccess wins)
  # Sitemap is generated (static pages + published posts).
  RewriteRule ^sitemap\.xml$ api/public/sitemap.php [L]
  # A Lab address is served with its own title, description, canonical, JSON-LD and readable
  # content (api/_lib/domain/lab-seo.php), not the bare shell every SPA address otherwise gets.
  # Any /study/<x> address goes there; one that is not a Lab gets the plain shell back, so the Lab
  # registry (domain/labs.php) stays the only list of Labs.
  RewriteRule ^study/[a-z]+(/.*)?$ api/public/lab-page.php [L]
  # The Timetable Maker's landing is one prerendered file, not a folder: a
  # timetable/ directory would turn the maker's own /timetable into a directory.
  RewriteRule ^timetable/about/?$ timetable-about.html [L]
  # A document's QR opens /verify/<number>?c=<check code> (domain/documents.php).
  # Only an NGG document number takes this road: /verify?t=… stays the SPA's
  # parent-consent page.
  RewriteRule ^verify/(NGG-[A-Za-z0-9-]+)/?$ api/public/doc-verify.php?no=$1 [QSA,L]
  RewriteRule ^(assets|uploads|api|vendor|apps-script|docs)/ - [L]

  # Everything else → the app shell, with the page's own head and a real 404 for an
  # unknown address (api/public/spa.php; SEO audit, 8 Nov 2026).
  RewriteRule ^ api/public/spa.php [L]
</IfModule>

# ErrorDocument fallbacks point back at the SPA
ErrorDocument 404 /api/public/spa.php
